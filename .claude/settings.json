{
  "permissions": {
    "deny": [
      "Edit(./coins/**)",
      "Read(./coins/**/originals/**)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-typecheck.sh",
            "timeout": 30,
            "statusMessage": "prettier + tsc"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-on-stop.sh",
            "timeout": 120,
            "statusMessage": "npm test"
          }
        ]
      }
    ]
  }
}
