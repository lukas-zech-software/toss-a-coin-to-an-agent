{
  "name": "toss-a-coin-to-an-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Coin capture & cataloguing pipeline (gphoto2 + OpenCV) – TypeScript, run natively by Node without a build step.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "capture": "node src/cli/capture.ts",
    "calibrate": "node src/cli/calibrate.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "prettier --write .",
    "typecheck": "tsc",
    "samples:fixtures": "node scripts/make-fixtures.ts",
    "samples:measure": "node scripts/measure-samples.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
